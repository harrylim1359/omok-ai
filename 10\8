class Door:

    def __init__(self, x, y):

        self.x = x
        self.y = y

        self.width = 50
        self.height = 80

        self.closed_image = pygame.image.load(
            os.path.join(base_path, "door.png")
        ).convert_alpha()

        self.open_image = pygame.image.load(
            os.path.join(base_path, "opendoor.png")
        ).convert_alpha()

        self.closed_image = pygame.transform.scale(
            self.closed_image,
            (self.width, self.height)
        )

        self.open_image = pygame.transform.scale(
            self.open_image,
            (self.width, self.height)
        )

        self.open = False

    def draw(self):

        if self.open:
            image = self.open_image
        else:
            image = self.closed_image

        rect = image.get_rect(
            center=(self.x, self.y)
        )

        screen.blit(
            image,
            rect
        )

    def is_player_touching(self, player):

        door_rect = pygame.Rect(
            self.x - self.width // 2,
            self.y - self.height // 2,
            self.width,
            self.height
        )

        player_rect = pygame.Rect(
            player.x - player.radius,
            player.y - player.radius,
            player.radius * 2,
            player.radius * 2
        )

        return door_rect.colliderect(player_rect)

# ==================================================
# Gun
# ==================================================

class Room:

    def __init__(self, room_number, wave):

        self.door = Door(
                    WIDTH - 30,
                    HEIGHT // 2
                )

        self.room_number = room_number
        self.wave = wave

        self.monsters = []

        self.started = False
        self.cleared = False

        self.chest = Chest(
            WIDTH // 2,
            HEIGHT // 2
        )

    def start(self):

        if self.started:
            return

        self.started = True

        zombie_count = 4 + self.wave

        for i in range(zombie_count):

            if self.wave % 5 == 0 and i == 0:

                zombie_type = "boss"

            else:

                random_number = random.randint(1, 100)

                if self.wave < 3:

                    if random_number <= 75:
                        zombie_type = "normal"
                    else:
                        zombie_type = "speed"

                elif self.wave < 5:

                    if random_number <= 55:
                        zombie_type = "normal"

                    elif random_number <= 80:
                        zombie_type = "speed"

                    else:
                        zombie_type = "tank"

                else:

                    if random_number <= 40:
                        zombie_type = "normal"

                    elif random_number <= 65:
                        zombie_type = "speed"

                    else:
                        zombie_type = "tank"

            self.monsters.append(
                Zombie(
                    self.wave,
                    zombie_type
                )
            )

    def update(self, player):

        if not self.started:
            self.start()

        if self.cleared:

            self.chest.update(player)

            return

        for monster in self.monsters:
            monster.update(player)

        self.monsters = [
            monster
            for monster in self.monsters
            if not monster.dead
        ]

        if len(self.monsters) == 0:

            self.cleared = True
            self.door.open = True

    def draw(self):

        for monster in self.monsters:
            monster.draw()
            monster.draw_health_bar()

        self.door.draw()

        if self.cleared:
            self.chest.draw()

class Gun:

    def __init__(self, image_path):

        self.image = pygame.image.load(
            os.path.join(base_path, image_path)
        ).convert_alpha()

        self.image = pygame.transform.scale(
            self.image,
            (30, 15)
        )

        

        self.image = pygame.transform.flip(
            self.image,
            False,
            True
        )

        self.x = 0
        self.y = 0
        self.angle = 0

    def update(self, x, y, mx, my):

        dx = mx - x
        dy = my - y

        distance = math.hypot(dx, dy)

        if distance != 0:
            dx /= distance
            dy /= distance

        # 플레이어에서 바라보는 방향으로 10만큼 떨어짐
        self.x = x + dx * 10
        self.y = y + dy * 10

        self.angle = math.degrees(
            math.atan2(-dy, dx)
        ) + 180

    def draw(self):

        image = pygame.transform.rotate(
            self.image,
            self.angle
        )

        rect = image.get_rect(
            center=(self.x, self.y)
        )

        screen.blit(image, rect)


# ==================================================
# Monster
# ==================================================

class Monster:

    def __init__(
        self,
        x,
        y,
        radius=18,
        speed=1.5,
        hp=30,
        damage=1
    ):

        self.x = x
        self.y = y

        self.radius = radius*5
        self.speed = speed

        self.hp = hp
        self.max_hp = hp

        self.damage = damage

        self.dead = False

        self.image = pygame.image.load(
            os.path.join(base_path, "zombie.png")
        ).convert_alpha()

        self.image = pygame.transform.scale(
            self.image,
            (self.radius * 2, self.radius * 2)
)

    # ==================================================
    # Update
    # ==================================================

    def update(self, player):
        pass

    # ==================================================
    # Move
    # ==================================================

    def move(self, player):

        dx = player.x - self.x
        dy = player.y - self.y

        distance = math.hypot(dx, dy)

        if distance > 0:

            self.x += dx / distance * self.speed
            self.y += dy / distance * self.speed

    # ==================================================
    # Attack
    # ==================================================

    def attack_player(self, player):

        distance = math.hypot(
            player.x - self.x,
            player.y - self.y
        )

        if distance < self.radius/5 + player.radius/5:

            player.hp -= self.damage

            if player.hp <= 0:
                player.hp = 0

    # ==================================================
    # Shoot
    # ==================================================

    def shoot(self, player):
        pass

    # ==================================================
    # Take Damage
    # ==================================================

    def take_damage(self, damage):

        self.hp -= damage

        if self.hp <= 0:

            self.hp = 0
            self.die()

    # ==================================================
    # Die
    # ==================================================

    def die(self):

        self.dead = True

    # ==================================================
    # Special Attack
    # ==================================================

    def special_attack(self, player):
        pass

    # ==================================================
    # Draw
    # ==================================================

    def draw(self):

        image = self.image.copy()

        # 좀비 종류별 색상 적용
        image.fill(
            self.color,
            special_flags=pygame.BLEND_RGBA_MULT
        )

        rect = image.get_rect(
            center=(self.x, self.y)
        )

        screen.blit(
            image,
            rect
        )

    # ==================================================
    # Health Bar
    # ==================================================

    def draw_health_bar(self):

        if self.type == "boss":

            bar_width = 70
            bar_height = 8

        elif self.type == "tank":

            bar_width = 55
            bar_height = 7

        else:

            bar_width = 40
            bar_height = 6

        hp_ratio = self.hp / self.max_hp

        pygame.draw.rect(
            screen,
            (180, 40, 40),
            (
                int(self.x - bar_width / 2),
                int(self.y - self.radius - 12),
                bar_width,
                bar_height
            )
        )

        pygame.draw.rect(
            screen,
            (50, 220, 70),
            (
                int(self.x - bar_width / 2),
                int(self.y - self.radius - 12),
                int(bar_width * hp_ratio),
                bar_height
            )
        )


# ==================================================
# Zombie
# ==================================================

class Zombie(Monster):

    def __init__(self, wave, zombie_type):

        side = random.randint(0, 3)

        if side == 0:

            x = random.randint(0, WIDTH)
            y = 0

        elif side == 1:

            x = random.randint(0, WIDTH)
            y = HEIGHT

        elif side == 2:

            x = 0
            y = random.randint(0, HEIGHT)

        else:

            x = WIDTH
            y = random.randint(0, HEIGHT)

        self.type = zombie_type

        # ==================================================
        # Normal
        # ==================================================

        if zombie_type == "normal":

            radius = 18

            speed = (
                1.5 +
                (wave - 1) * 0.15
            )

            hp = (
                30 +
                (wave - 1) * 10
            )

            damage = (
                1 +
                (wave - 1) // 3
            )

            color = (60, 200, 70)

            coin_reward = 5

        # ==================================================
        # Speed
        # ==================================================

        elif zombie_type == "speed":

            radius = 14

            speed = (
                3.0 +
                (wave - 1) * 0.20
            )

            hp = (
                15 +
                (wave - 1) * 5
            )

            damage = (
                1 +
                (wave - 1) // 4
            )

            color = (255, 220, 50)

            coin_reward = 8

        # ==================================================
        # Tank
        # ==================================================

        elif zombie_type == "tank":

            radius = 25

            speed = (
                0.8 +
                (wave - 1) * 0.08
            )

            hp = (
                80 +
                (wave - 1) * 20
            )

            damage = (
                2 +
                (wave - 1) // 3
            )

            color = (220, 60, 60)

            coin_reward = 12

        # ==================================================
        # Boss
        # ==================================================

        elif zombie_type == "boss":

            radius = 35

            speed = (
                1.0 +
                (wave - 1) * 0.10
            )

            hp = (
                250 +
                (wave - 1) * 50
            )

            damage = (
                5 +
                (wave - 1) // 2
            )

            color = (170, 50, 220)

            coin_reward = 50

        super().__init__(
            x=x,
            y=y,
            radius=radius,
            speed=speed,
            hp=hp,
            damage=damage
        )

        self.color = color
        self.coin_reward = coin_reward

    def update(self, player):

        self.move(player)
        self.attack_player(player)


# ==================================================
# Player
# ==================================================

class Player:

    def __init__(self):

        self.x = 450
        self.y = 300

        self.radius = 20

        self.speed = 5

        self.max_hp = 100
        self.hp = 100

        self.damage = 15

        self.fire_cooldown = 10
        self.cooldown = 0

        self.gun = Gun("gun.png")

    def update(self):

        keys = pygame.key.get_pressed()

        if keys[pygame.K_w]:
            self.y -= self.speed

        if keys[pygame.K_s]:
            self.y += self.speed

        if keys[pygame.K_a]:
            self.x -= self.speed

        if keys[pygame.K_d]:
            self.x += self.speed

        self.x = max(
            self.radius,
            min(WIDTH - self.radius, self.x)
        )

        self.y = max(
            self.radius,
            min(HEIGHT - self.radius, self.y)
        )

        if self.cooldown > 0:
            self.cooldown -= 1

        # 총 방향 업데이트
        mx, my = pygame.mouse.get_pos()

        self.gun.update(
            self.x,
            self.y,
            mx,
            my
        )

    def shoot(self, mx, my):

        if self.cooldown > 0:
            return None

        dx = mx - self.x
        dy = my - self.y

        distance = math.hypot(dx, dy)

        if distance == 0:
            return None

        dx /= distance
        dy /= distance

        self.cooldown = self.fire_cooldown

        return Bullet(
            self.x,
            self.y,
            dx,
            dy,
            self.damage
        )

    def draw(self):

        pygame.draw.circle(
            screen,
            (50, 150, 255),
            (
                int(self.x),
                int(self.y)
            ),
            self.radius
        )

        self.gun.draw()

    def draw_health_bar(self):

        bar_width = 50
        bar_height = 7

        hp_ratio = self.hp / self.max_hp

        pygame.draw.rect(
            screen,
            (180, 40, 40),
            (
                int(self.x - bar_width / 2),
                int(self.y - 35),
                bar_width,
                bar_height
            )
        )

        pygame.draw.rect(
            screen,
            (50, 220, 70),
            (
                int(self.x - bar_width / 2),
                int(self.y - 35),
                int(bar_width * hp_ratio),
                bar_height
            )
        )


