class Bullet:

    def __init__(
        self,
        x,
        y,
        dx,
        dy,
        damage
    ):

        self.x = x
        self.y = y

        self.dx = dx
        self.dy = dy

        self.speed = 12
        self.radius = 5

        self.damage = damage

    def update(self):

        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def draw(self):

        pygame.draw.circle(
            screen,
            (255, 230, 50),
            (
                int(self.x),
                int(self.y)
            ),
            self.radius
        )


# ==================================================
# Game
# ==================================================

class Game:

    def __init__(self):

        self.shop_levels = {
            "damage": 0,
            "speed": 0,
            "heal": 0,
            "fire_cooldown": 0,
            "max_hp" : 0
        }
        self.shooting = False

        self.player = Player()

        self.bullets = []

        self.wave = 1

        self.coins = 0

        self.room = Room(
            room_number=0,
            wave=self.wave
        )

        self.shop_open = False

        self.game_over = False

    # ==================================================
    # Game Update
    # ==================================================

    def update(self):

        if self.game_over:
            return

        # --------------------------------------------------
        # Player
        # --------------------------------------------------

        self.player.update()

        if self.shooting and not self.game_over and not self.shop_open:

            mx, my = pygame.mouse.get_pos()

            bullet = self.player.shoot(mx, my)

            if bullet is not None:
                self.bullets.append(bullet)

        # --------------------------------------------------
        # Bullets
        # --------------------------------------------------

        for bullet in self.bullets[:]:

            bullet.update()

            # 화면 밖으로 나가면 삭제
            if (
                bullet.x < 0 or
                bullet.x > WIDTH or
                bullet.y < 0 or
                bullet.y > HEIGHT
            ):

                self.bullets.remove(bullet)

                continue

            # 현재 Room의 몬스터와 충돌
            for monster in self.room.monsters:

                distance = math.hypot(
                    bullet.x - monster.x,
                    bullet.y - monster.y
                )

                if distance < bullet.radius/2 + monster.radius/2:

                    monster.take_damage(
                        bullet.damage
                    )

                    if bullet in self.bullets:
                        self.bullets.remove(bullet)

                    # 죽었으면 코인 지급
                    if monster.dead:

                        self.coins += monster.coin_reward

                    break

        # --------------------------------------------------
        # Room
        # --------------------------------------------------

        self.room.update(
            self.player
        )

        # --------------------------------------------------
        # Game Over
        # --------------------------------------------------

        if self.player.hp <= 0:

            self.player.hp = 0

            self.game_over = True

        # ==================================================
        # Room Clear
        # ==================================================

        if self.room.cleared:

            if self.room.door.is_player_touching(self.player):

                self.wave += 1

                self.room = Room(
                    room_number=self.room.room_number + 1,
                    wave=self.wave
                )

                # 새 방의 입구에서 시작
                self.player.x = 100
                self.player.y = HEIGHT // 2

    # ==================================================
    # Draw
    # ==================================================

    def draw(self):

        screen.fill(
            (25, 25, 25)
        )

        # --------------------------------------------------
        # Room
        # --------------------------------------------------

        self.room.draw()

        # --------------------------------------------------
        # Bullets
        # --------------------------------------------------

        for bullet in self.bullets:
            bullet.draw()

        # --------------------------------------------------
        # Player
        # --------------------------------------------------

        self.player.draw()

        self.player.draw_health_bar()
        
        hp_text = font.render(
            f"{self.player.hp}/{self.player.max_hp}",
            True,
            (255, 255, 255)
        )

        hp_rect = hp_text.get_rect(
            midtop=(WIDTH // 2, 10)
        )

        screen.blit(
            hp_text,
            hp_rect
        )

        # --------------------------------------------------
        # UI
        # --------------------------------------------------

        coin_text = font.render(
            f"Coins: {self.coins}",
            True,
            (255, 215, 0)
        )

        wave_text = font.render(
            f"Room: {self.room.room_number + 1}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            coin_text,
            (10, 10)
        )

        screen.blit(
            wave_text,
            (10, 40)
        )

        # --------------------------------------------------
        # Controls
        # --------------------------------------------------

        control_text = font.render(
            "WASD: Move   Mouse: Shoot   B: Shop",
            True,
            (200, 200, 200)
        )

        screen.blit(
            control_text,
            (10, HEIGHT - 30)
        )

        # --------------------------------------------------
        # Shop
        # --------------------------------------------------

        if self.shop_open:

            self.draw_shop()

        # --------------------------------------------------
        # Game Over
        # --------------------------------------------------

        if self.game_over:

            game_over_text = big_font.render(
                "GAME OVER",
                True,
                (255, 80, 80)
            )

            restart_text = font.render(
                "Press R to restart",
                True,
                (255, 255, 255)
            )

            screen.blit(
                game_over_text,
                game_over_text.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 - 30)
                )
            )

            screen.blit(
                restart_text,
                restart_text.get_rect(
                    center=(WIDTH // 2, HEIGHT // 2 + 30)
                )
            )

    # ==================================================
    # Shop
    # ==================================================

    def draw_shop(self):

        # 상점 배경
        shop_rect = pygame.Rect(
            200,
            100,
            500,
            400
        )

        pygame.draw.rect(
            screen,
            (40, 40, 40),
            shop_rect
        )

        # 현재 가격
        damage_price = 20 + self.shop_levels["damage"] * 10
        speed_price = 25 + self.shop_levels["speed"] * 10
        heal_price = min(15 + self.shop_levels["heal"] * 10,100)
        fire_price = 30 + self.shop_levels["fire_cooldown"] * 15
        max_hp_price = 40 + self.shop_levels["max_hp"] * 15

        title = big_font.render(
            "SHOP",
            True,
            (255, 255, 255)
        )

        screen.blit(
            title,
            (380, 120)
        )

        text1 = font.render(
            f"1. Damage +5   ({damage_price} Coins)",
            True,
            (255, 255, 255)
        )

        text2 = font.render(
            f"2. Speed +1    ({speed_price} Coins)",
            True,
            (255, 255, 255)
        )

        text3 = font.render(
            f"3. Heal +30    ({heal_price} Coins)",
            True,
            (255, 255, 255)
        )

        text4 = font.render(
            f"4. Fire Rate   ({fire_price} Coins)",
            True,
            (255, 255, 255)
        )
        
        text5 = font.render(
            f"5. Max HP +20   ({max_hp_price} Coins)",
            True,
            (255, 255, 255)
        )

        screen.blit(text1, (250, 200))
        screen.blit(text2, (250, 250))
        screen.blit(text3, (250, 300))
        screen.blit(text4, (250, 350))
        screen.blit(text5, (250, 400))

    # ==================================================
    # Event
    # ==================================================

    def handle_event(self, event):

        # --------------------------------------------------
        # Mouse
        # --------------------------------------------------

        if event.type == pygame.MOUSEBUTTONDOWN:

            if event.button == 1:

                if not self.game_over:

                    mx, my = pygame.mouse.get_pos()

                    bullet = self.player.shoot(
                        mx,
                        my
                    )

                    if bullet is not None:

                        self.bullets.append(
                            bullet
                        )

        # --------------------------------------------------
        # Keyboard
        # --------------------------------------------------

        if event.type == pygame.KEYDOWN:

            # Shop
            if event.key == pygame.K_b:

                if not self.game_over:

                    self.shop_open = not self.shop_open

            # Restart
            if event.key == pygame.K_r:

                if self.game_over:

                    self.__init__()

            # Shop items
            if self.shop_open:

                # Damage
                if event.key == pygame.K_1:

                    if self.coins >= 20:

                        self.coins -= 20

                        self.player.damage += 5

                # Speed
                elif event.key == pygame.K_2:

                    if self.coins >= 25:

                        self.coins -= 25

                        self.player.speed += 1

                # Heal
                elif event.key == pygame.K_3:

                    if self.coins >= 15:

                        self.coins -= 15

                        self.player.hp += 30

                        if self.player.hp > self.player.max_hp:

                            self.player.hp = self.player.max_hp

                # Fire rate
                elif event.key == pygame.K_4:

                    if self.coins >= 30:

                        self.coins -= 30

                        self.player.fire_cooldown -= 2

                        if self.player.fire_cooldown < 2:

                            self.player.fire_cooldown = 2
    def events(self):

        for event in pygame.event.get():

            # 창 닫기
            if event.type == pygame.QUIT:
                return False

            # 마우스 클릭
            if event.type == pygame.MOUSEBUTTONDOWN:

                if event.button == 1:

                    if not self.game_over and not self.shop_open:
                        self.shooting = True


            if event.type == pygame.MOUSEBUTTONUP:

                if event.button == 1:
                    self.shooting = False

            # 키보드
            if event.type == pygame.KEYDOWN:

                # 상점 열기 / 닫기
                if event.key == pygame.K_b:

                    if not self.game_over:
                        self.shop_open = not self.shop_open

                # 게임 오버 후 재시작
                if event.key == pygame.K_r:

                    if self.game_over:
                        self.__init__()

                # 상점
                if self.shop_open:

                    # Damage +5
                    if event.key == pygame.K_1:

                        price = 20 + self.shop_levels["damage"] * 10

                        if self.coins >= price:

                            self.coins -= price
                            self.player.damage += 5
                            self.shop_levels["damage"] += 1

                    # Speed +1
                    elif event.key == pygame.K_2:

                        price = 25 + self.shop_levels["speed"] * 10

                        if self.coins >= price:

                            self.coins -= price
                            self.player.speed += 1
                            self.shop_levels["speed"] += 1

                    # Heal +30
                    elif event.key == pygame.K_3:

                        price = 15 + self.shop_levels["heal"] * 10

                        if self.coins >= price:

                            self.coins -= price
                            self.player.hp += 30

                            if self.player.hp > self.player.max_hp:
                                self.player.hp = self.player.max_hp

                            self.shop_levels["heal"] += 1

                    # Fire cooldown -2
                    elif event.key == pygame.K_4:

                        price = 30 + self.shop_levels["fire_cooldown"] * 15

                        if self.coins >= price:

                            if self.player.fire_cooldown > 2:

                                self.coins -= price
                                self.player.fire_cooldown -= 2
                                self.shop_levels["fire_cooldown"] += 1
                                        # Max HP +20
                    elif event.key == pygame.K_5:

                        price = 40 + self.shop_levels["max_hp"] * 15

                        if self.coins >= price:

                            self.coins -= price
                            self.player.max_hp += 20
                            self.player.hp += 20
                            self.shop_levels["max_hp"] += 1

        return True


