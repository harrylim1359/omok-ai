# ==================================================
# Chest
# ==================================================

class Chest:

    def __init__(self, x, y):

        self.x = x
        self.y = y

        self.width = 60
        self.height = 60

        self.closed_image = pygame.image.load(
            os.path.join(base_path, "chest.png")
        ).convert_alpha()

        self.open_image = pygame.image.load(
            os.path.join(base_path, "openchest.png")
        ).convert_alpha()

        self.closed_image = pygame.transform.scale(
            self.closed_image,
            (self.width, self.height)
        )

        self.open_image = pygame.transform.scale(
            self.open_image,
            (self.width, self.height)
        )

        self.open = False

    def is_player_touching(self, player):

        chest_rect = pygame.Rect(
            self.x - self.width // 2,
            self.y - self.height // 2,
            self.width,
            self.height
        )

        player_rect = pygame.Rect(
            player.x - player.radius,
            player.y - player.radius,
            player.radius * 2,
            player.radius * 2
        )

        return chest_rect.colliderect(player_rect)

    def update(self, player):

        if not self.open:

            if self.is_player_touching(player):
                self.open = True

    def draw(self):

        if self.open:
            image = self.open_image
        else:
            image = self.closed_image

        rect = image.get_rect(
            center=(self.x, self.y)
        )

        screen.blit(
            image,
            rect
        )

