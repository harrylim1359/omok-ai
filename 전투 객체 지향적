# =========================
# Particle 클래스
# =========================

class Particle:

    def __init__(self, x, y, color):
        self.x = x
        self.y = y

        self.vx = random.uniform(-4, 4)
        self.vy = random.uniform(-4, 4)

        self.life = random.randint(15, 30)

        self.color = color
        self.size = random.randint(3, 7)

    def update(self):
        self.x += self.vx
        self.y += self.vy

        self.vx *= 0.95
        self.vy *= 0.95

        self.life -= 1

    def draw(self, screen):

        if self.life > 0:

            pygame.draw.circle(
                screen,
                self.color,
                (int(self.x), int(self.y)),
                self.size
            )

    def is_alive(self):
        return self.life > 0


# =========================
# Obstacle 클래스
# =========================

class Obstacle:

    def __init__(self, x, y, width, height):

        self.rect = pygame.Rect(
            x,
            y,
            width,
            height
        )

    def draw(self, screen):

        pygame.draw.rect(
            screen,
            GRAY,
            self.rect,
            border_radius=8
        )

        pygame.draw.rect(
            screen,
            LIGHT_GRAY,
            self.rect,
            2,
            border_radius=8
        )

    def collides(self, x, y):

        player_rect = pygame.Rect(
            int(x - 18),
            int(y - 18),
            36,
            36
        )

        return self.rect.colliderect(player_rect)


# =========================
# GameData 클래스
# =========================

class GameData:

    def __init__(self):

        # 전체 게임의 공격 데이터
        self.game_history = []

    def record_attack(
        self,
        player_number,
        distance
    ):

        data = {
            "player": player_number,
            "action": "attack",
            "distance": round(distance, 2)
        }

        self.game_history.append(data)

    def get_recent_data(self, count=10):

        return self.game_history[-count:]

    def print_data(self, player1, player2):

        print()
        print("==============================")
        print("          GAME DATA")
        print("==============================")

        print(
            "P1 행동 데이터:",
            len(player1.action_history)
        )

        print(
            "P2 행동 데이터:",
            len(player2.action_history)
        )

        print(
            "공격 데이터:",
            len(self.game_history)
        )

        print()
        print("최근 공격 데이터:")

        for data in self.get_recent_data():

            print(data)


# =========================
# Player 클래스
# =========================

class Player:

    def __init__(
        self,
        x,
        y,
        color,
        controls,
        name,
        player_number,
        obstacles
    ):

        # 위치
        self.start_x = x
        self.start_y = y

        self.x = x
        self.y = y

        # 기본 정보
        self.color = color
        self.name = name
        self.player_number = player_number

        # 조작키
        self.controls = controls

        # 장애물
        self.obstacles = obstacles

        # 이동
        self.speed = 4.5

        # 체력
        self.max_hp = 100
        self.hp = 100

        # 공격
        self.attack_range = 75
        self.attack_damage = 12

        self.attack_cooldown = 0
        self.attack_delay = 35

        self.attacking = False
        self.attack_timer = 0

        # 대시
        self.dash_cooldown = 0
        self.dash_delay = 90

        # 바라보는 방향
        self.direction_x = 1
        self.direction_y = 0

        # AI 학습용 데이터
        self.action_history = []

    # -------------------------
    # 이동
    # -------------------------

    def move(self, keys):

        dx = 0
        dy = 0

        if keys[self.controls["up"]]:
            dy -= 1

        if keys[self.controls["down"]]:
            dy += 1

        if keys[self.controls["left"]]:
            dx -= 1

        if keys[self.controls["right"]]:
            dx += 1

        # 움직이지 않았다면 종료
        if dx == 0 and dy == 0:
            return

        # 대각선 이동 속도 보정
        length = math.sqrt(
            dx * dx + dy * dy
        )

        dx /= length
        dy /= length

        # 방향 저장
        self.direction_x = dx
        self.direction_y = dy

        # 새로운 위치
        new_x = self.x + dx * self.speed
        new_y = self.y + dy * self.speed

        # 장애물과 충돌하지 않으면 이동
        if not self.collides(new_x, new_y):

            self.x = new_x
            self.y = new_y

        # AI 학습 데이터 저장
        self.action_history.append({

            "action": "move",

            "x": round(self.x, 1),
            "y": round(self.y, 1),

            "dx": round(dx, 2),
            "dy": round(dy, 2)
        })

    # -------------------------
    # 충돌 확인
    # -------------------------

    def collides(self, x, y):

        for obstacle in self.obstacles:

            if obstacle.collides(x, y):
                return True

        return False

    # -------------------------
    # 대시
    # -------------------------

    def dash(self):

        if self.dash_cooldown > 0:
            return

        dx = self.direction_x
        dy = self.direction_y

        # 방향이 없으면 오른쪽
        if dx == 0 and dy == 0:
            dx = 1

        # 여러 번 이동해서 빠르게 이동
        for _ in range(10):

            new_x = self.x + dx * 8
            new_y = self.y + dy * 8

            if not self.collides(
                new_x,
                new_y
            ):

                self.x = new_x
                self.y = new_y

            else:
                break

        self.dash_cooldown = self.dash_delay

        self.action_history.append({

            "action": "dash",

            "x": round(self.x, 1),
            "y": round(self.y, 1)
        })

    # -------------------------
    # 공격
    # -------------------------

    def attack(self, target, particle_manager, game_data):

        # 쿨타임
        if self.attack_cooldown > 0:
            return

        self.attack_cooldown = self.attack_delay

        self.attacking = True
        self.attack_timer = 15

        # 상대와 거리 계산
        distance = math.dist(
            (self.x, self.y),
            (target.x, target.y)
        )

        # 공격 성공
        if distance <= self.attack_range:

            target.take_damage(
                self.attack_damage
            )

            particle_manager.create(
                target.x,
                target.y,
                YELLOW
            )

            self.action_history.append({

                "action": "hit",

                "distance": round(
                    distance,
                    2
                )
            })

        # 공격 실패
        else:

            self.action_history.append({

                "action": "miss",

                "distance": round(
                    distance,
                    2
                )
            })

        # 전체 게임 데이터에도 기록
        game_data.record_attack(
            self.player_number,
            distance
        )

    # -------------------------
    # 데미지 받기
    # -------------------------

    def take_damage(self, damage):

        self.hp -= damage

        if self.hp < 0:
            self.hp = 0

    # -------------------------
    # 상태 업데이트
    # -------------------------

    def update(self):

        if self.attack_cooldown > 0:
            self.attack_cooldown -= 1

        if self.dash_cooldown > 0:
            self.dash_cooldown -= 1

        if self.attack_timer > 0:

            self.attack_timer -= 1

        else:

            self.attacking = False

        # 맵 밖으로 못 나가게 함
        self.x = max(
            30,
            min(WIDTH - 30, self.x)
        )

        self.y = max(
            MAP_TOP + 35,
            min(MAP_BOTTOM - 35, self.y)
        )

    # -------------------------
    # 플레이어 그리기
    # -------------------------

    def draw(self, screen):

        x = int(self.x)
        y = int(self.y)

        # 그림자
        pygame.draw.ellipse(
            screen,
            (10, 10, 12),
            (
                x - 22,
                y + 28,
                44,
                12
            )
        )

        # 머리
        pygame.draw.circle(
            screen,
            self.color,
            (x, y - 30),
            13
        )

        # 몸
        pygame.draw.line(
            screen,
            self.color,
            (x, y - 16),
            (x, y + 15),
            9
        )

        # 팔
        if self.attacking:

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (
                    x + self.direction_x * 28,
                    y - 8 + self.direction_y * 28
                ),
                7
            )

        else:

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (x - 18, y + 10),
                6
            )

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (x + 18, y + 10),
                6
            )

        # 다리
        pygame.draw.line(
            screen,
            self.color,
            (x, y + 15),
            (x - 14, y + 40),
            7
        )

        pygame.draw.line(
            screen,
            self.color,
            (x, y + 15),
            (x + 14, y + 40),
            7
        )

        # 공격 이펙트
        if self.attacking:

            angle = math.atan2(
                self.direction_y,
                self.direction_x
            )

            sword_length = 65

            start_x = (
                x +
                math.cos(angle) * 18
            )

            start_y = (
                y +
                math.sin(angle) * 18
            )

            end_x = (
                x +
                math.cos(angle) *
                sword_length
            )

            end_y = (
                y +
                math.sin(angle) *
                sword_length
            )

            # 칼
            pygame.draw.line(
                screen,
                WHITE,
                (start_x, start_y),
                (end_x, end_y),
                7
            )

            # 칼 손잡이
            pygame.draw.line(
                screen,
                ORANGE,

                (
                    start_x -
                    math.sin(angle) * 10,

                    start_y +
                    math.cos(angle) * 10
                ),

                (
                    start_x +
                    math.sin(angle) * 10,

                    start_y -
                    math.cos(angle) * 10
                ),

                5
            )

            # 공격 범위
            pygame.draw.arc(
                screen,
                YELLOW,

                (
                    x - 50,
                    y - 50,
                    100,
                    100
                ),

                angle - 0.8,
                angle + 0.8,
                4
            )

        # 이름
        name_text = small_font.render(
            self.name,
            True,
            WHITE
        )

        screen.blit(
            name_text,
            (
                x -
                name_text.get_width() // 2,
                y - 65
            )
        )

    # -------------------------
    # 게임 초기화
    # -------------------------

    def reset(self):

        self.x = self.start_x
        self.y = self.start_y

        self.hp = self.max_hp

        self.attack_cooldown = 0
        self.dash_cooldown = 0

        self.attacking = False
        self.attack_timer = 0

        self.direction_x = 1
        self.direction_y = 0

        self.action_history.clear()


# =========================
# ParticleManager 클래스
# =========================

class ParticleManager:

    def __init__(self):

        self.particles = []

    def create(self, x, y, color):

        for _ in range(15):

            self.particles.append(
                Particle(
                    x,
                    y,
                    color
                )
            )

    def update(self):

        for particle in self.particles:

            particle.update()

        self.particles = [

            particle

            for particle in self.particles

            if particle.is_alive()
        ]

    def draw(self, screen):

        for particle in self.particles:

            particle.draw(screen)

    def clear(self):

        self.particles.clear()


# =========================
# Game 클래스
# =========================

class Game:

    def __init__(self):

        # 게임 상태
        self.running = True
        self.game_over = False
        self.winner = None

        # 장애물
        self.obstacles = self.create_obstacles()

        # 이펙트
        self.particle_manager = ParticleManager()

        # AI 학습 데이터
        self.game_data = GameData()

        # 플레이어
        self.player1 = Player(
            180,
            350,
            BLUE,

            {
                "up": pygame.K_w,
                "down": pygame.K_s,
                "left": pygame.K_a,
                "right": pygame.K_d
            },

            "PLAYER 1",
            1,

            self.obstacles
        )

        self.player2 = Player(
            920,
            350,
            RED,

            {
                "up": pygame.K_UP,
                "down": pygame.K_DOWN,
                "left": pygame.K_LEFT,
                "right": pygame.K_RIGHT
            },

            "PLAYER 2",
            2,

            self.obstacles
        )

    # -------------------------
    # 장애물 생성
    # -------------------------

    def create_obstacles(self):

        return [

            Obstacle(
                350,
                210,
                150,
                40
            ),

            Obstacle(
                600,
                210,
                150,
                40
            ),

            Obstacle(
                350,
                450,
                150,
                40
            ),

            Obstacle(
                600,
                450,
                150,
                40
            ),

            Obstacle(
                510,
                290,
                80,
                120
            )
        ]

    # -------------------------
    # 이벤트 처리
    # -------------------------

    def handle_events(self):

        for event in pygame.event.get():

            if event.type == pygame.QUIT:

                self.running = False

            if event.type == pygame.KEYDOWN:

                # P1 공격
                if (
                    event.key == pygame.K_f
                    and not self.game_over
                ):

                    self.player1.attack(
                        self.player2,
                        self.particle_manager,
                        self.game_data
                    )

                # P1 대시
                if (
                    event.key == pygame.K_g
                    and not self.game_over
                ):

                    self.player1.dash()

                # P2 공격
                if (
                    event.key == pygame.K_l
                    and not self.game_over
                ):

                    self.player2.attack(
                        self.player1,
                        self.particle_manager,
                        self.game_data
                    )

                # P2 대시
                if (
                    event.key == pygame.K_k
                    and not self.game_over
                ):

                    self.player2.dash()

                # 재시작
                if event.key == pygame.K_r:

                    self.reset()

    # -------------------------
    # 게임 업데이트
    # -------------------------

    def update(self):

        if self.game_over:
            return

        keys = pygame.key.get_pressed()

        # 플레이어 이동
        self.player1.move(keys)
        self.player2.move(keys)

        # 상태 업데이트
        self.player1.update()
        self.player2.update()

        # 파티클
        self.particle_manager.update()

        # 승패 확인
        self.check_winner()

    # -------------------------
    # 승패 확인
    # -------------------------

    def check_winner(self):

        if self.player1.hp <= 0:

            self.player1.hp = 0

            self.game_over = True

            self.winner = "PLAYER 2"

        elif self.player2.hp <= 0:

            self.player2.hp = 0

            self.game_over = True

            self.winner = "PLAYER 1"

    # -------------------------
    # HP 바
    # -------------------------

    def draw_hp_bar(
        self,
        x,
        y,
        hp,
        color,
        name
    ):

        width = 380
        height = 24

        # 배경
        pygame.draw.rect(
            screen,
            DARK_GRAY,
            (
                x,
                y,
                width,
                height
            )
        )

        # HP
        hp_width = int(
            width * hp / 100
        )

        pygame.draw.rect(
            screen,
            color,
            (
                x,
                y,
                hp_width,
                height
            )
        )

        # 테두리
        pygame.draw.rect(
            screen,
            WHITE,
            (
                x,
                y,
                width,
                height
            ),
            2
        )

        # 글자
        text = font.render(
            f"{name}  HP: {hp}",
            True,
            WHITE
        )

        screen.blit(
            text,
            (
                x,
                y - 32
            )
        )

    # -------------------------
    # 맵 그리기
    # -------------------------

    def draw_map(self):

        # 배경
        screen.fill(
            (25, 28, 35)
        )

        # 위쪽 UI
        pygame.draw.rect(
            screen,
            (35, 38, 48),
            (
                0,
                0,
                WIDTH,
                110
            )
        )

        # HP
        self.draw_hp_bar(
            40,
            65,
            self.player1.hp,
            BLUE,
            "PLAYER 1"
        )

        self.draw_hp_bar(
            WIDTH - 420,
            65,
            self.player2.hp,
            RED,
            "PLAYER 2"
        )

        # 맵
        pygame.draw.rect(
            screen,
            (32, 35, 42),
            (
                0,
                MAP_TOP,
                WIDTH,
                MAP_BOTTOM - MAP_TOP
            )
        )

        # 격자
        for x in range(0, WIDTH, 50):

            pygame.draw.line(
                screen,
                (38, 41, 49),
                (x, MAP_TOP),
                (x, MAP_BOTTOM),
                1
            )

        for y in range(
            MAP_TOP,
            MAP_BOTTOM,
            50
        ):

            pygame.draw.line(
                screen,
                (38, 41, 49),
                (0, y),
                (WIDTH, y),
                1
            )

        # 장애물
        for obstacle in self.obstacles:

            obstacle.draw(screen)

        # 중앙 원
        pygame.draw.circle(
            screen,
            (45, 48, 58),
            (WIDTH // 2, 350),
            100,
            3
        )

    # -------------------------
    # UI
    # -------------------------

    def draw_ui(self):

        p1_text = small_font.render(
            "P1  WASD 이동 | F 공격 | G 대시",
            True,
            LIGHT_BLUE
        )

        p2_text = small_font.render(
            "P2  방향키 이동 | L 공격 | K 대시",
            True,
            LIGHT_RED
        )

        screen.blit(
            p1_text,
            (20, HEIGHT - 40)
        )

        screen.blit(
            p2_text,
            (WIDTH - 350, HEIGHT - 40)
        )

    # -------------------------
    # 게임 오버 화면
    # -------------------------

    def draw_game_over(self):

        if not self.game_over:
            return

        overlay = pygame.Surface(
            (WIDTH, HEIGHT),
            pygame.SRCALPHA
        )

        overlay.fill(
            (0, 0, 0, 190)
        )

        screen.blit(
            overlay,
            (0, 0)
        )

        win_text = big_font.render(
            self.winner + " WIN!",
            True,
            YELLOW
        )

        screen.blit(
            win_text,
            (
                WIDTH // 2 -
                win_text.get_width() // 2,

                HEIGHT // 2 - 60
            )
        )

        restart_text = font.render(
            "R 키를 눌러 다시 시작",
            True,
            WHITE
        )

        screen.blit(
            restart_text,
            (
                WIDTH // 2 -
                restart_text.get_width() // 2,

                HEIGHT // 2 + 30
            )
        )

    # -------------------------
    # 전체 화면 그리기
    # -------------------------

    def draw(self):

        self.draw_map()

        self.particle_manager.draw(
            screen
        )

        self.player1.draw(screen)
        self.player2.draw(screen)

        self.draw_ui()

        self.draw_game_over()

        pygame.display.flip()

    # -------------------------
    # 게임 초기화
    # -------------------------

    def reset(self):

        self.player1.reset()
        self.player2.reset()

        self.particle_manager.clear()

        self.game_data.game_history.clear()

        self.game_over = False
        self.winner = None

    # -------------------------
    # 게임 실행
    # -------------------------

    def run(self):

        while self.running:

            clock.tick(FPS)

            self.handle_events()

            self.update()

            self.draw()

        pygame.quit()

        # AI 학습 데이터 출력
        self.game_data.print_data(
            self.player1,
            self.player2
        )


# =========================
# 프로그램 시작
# =========================

if __name__ == "__main__":

    game = Game()

    game.run()
