import pygame
import math
import random

pygame.init()

WIDTH = 900
HEIGHT = 600

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Zombie Wave")

clock = pygame.time.Clock()
font = pygame.font.SysFont(None, 30)
big_font = pygame.font.SysFont(None, 60)


# =========================
# Player
# =========================

class Player:

    def __init__(self):

        self.x = 450
        self.y = 300

        self.radius = 20
        self.speed = 5

        self.hp = 100
        self.max_hp = 100

        self.cooldown = 0

    def update(self):

        keys = pygame.key.get_pressed()

        if keys[pygame.K_w]:
            self.y -= self.speed

        if keys[pygame.K_s]:
            self.y += self.speed

        if keys[pygame.K_a]:
            self.x -= self.speed

        if keys[pygame.K_d]:
            self.x += self.speed

        # 화면 밖으로 못 나가게
        self.x = max(20, min(WIDTH - 20, self.x))
        self.y = max(20, min(HEIGHT - 20, self.y))

        if self.cooldown > 0:
            self.cooldown -= 1

    def shoot(self, mx, my):

        if self.cooldown > 0:
            return None

        dx = mx - self.x
        dy = my - self.y

        distance = math.hypot(dx, dy)

        if distance == 0:
            return None

        dx /= distance
        dy /= distance

        self.cooldown = 10

        return Bullet(
            self.x,
            self.y,
            dx,
            dy
        )

    def draw(self):

        pygame.draw.circle(
            screen,
            (50, 150, 255),
            (int(self.x), int(self.y)),
            self.radius
        )


# =========================
# Bullet
# =========================

class Bullet:

    def __init__(self, x, y, dx, dy):

        self.x = x
        self.y = y

        self.dx = dx
        self.dy = dy

        self.speed = 12
        self.radius = 5

    def update(self):

        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def draw(self):

        pygame.draw.circle(
            screen,
            (255, 230, 50),
            (int(self.x), int(self.y)),
            self.radius
        )


# =========================
# Zombie
# =========================

class Zombie:

    def __init__(self):

        side = random.randint(0, 3)

        if side == 0:
            self.x = random.randint(0, WIDTH)
            self.y = 0

        elif side == 1:
            self.x = random.randint(0, WIDTH)
            self.y = HEIGHT

        elif side == 2:
            self.x = 0
            self.y = random.randint(0, HEIGHT)

        else:
            self.x = WIDTH
            self.y = random.randint(0, HEIGHT)

        self.radius = 18

        self.speed = 1.5

        self.hp = 30

    def update(self, player):

        dx = player.x - self.x
        dy = player.y - self.y

        distance = math.hypot(dx, dy)

        if distance > 0:

            self.x += dx / distance * self.speed
            self.y += dy / distance * self.speed

    def draw(self):

        pygame.draw.circle(
            screen,
            (60, 200, 70),
            (int(self.x), int(self.y)),
            self.radius
        )


# =========================
# Game
# =========================

class Game:

    def __init__(self):

        self.player = Player()

        self.bullets = []
        self.zombies = []

        # 웨이브
        self.wave = 1

        self.spawn_wave()

        self.game_over = False

    # -------------------------
    # 웨이브 시작
    # -------------------------

    def spawn_wave(self):

        self.zombies.clear()

        # 웨이브가 올라갈수록 좀비 증가
        zombie_count = 4 + self.wave

        for i in range(zombie_count):

            self.zombies.append(
                Zombie()
            )

    # -------------------------
    # 이벤트
    # -------------------------

    def events(self):

        for event in pygame.event.get():

            if event.type == pygame.QUIT:
                return False

            # 마우스 공격
            if event.type == pygame.MOUSEBUTTONDOWN:

                if event.button == 1:

                    if not self.game_over:

                        mx, my = pygame.mouse.get_pos()

                        bullet = self.player.shoot(
                            mx,
                            my
                        )

                        if bullet:

                            self.bullets.append(
                                bullet
                            )

            # R = 재시작
            if event.type == pygame.KEYDOWN:

                if event.key == pygame.K_r:

                    if self.game_over:

                        self.__init__()

        return True

    # -------------------------
    # 업데이트
    # -------------------------

    def update(self):

        if self.game_over:
            return

        self.player.update()

        # 총알 이동
        for bullet in self.bullets:

            bullet.update()

        # 좀비 이동
        for zombie in self.zombies:

            zombie.update(
                self.player
            )

        # -------------------------
        # 총알 충돌
        # -------------------------

        for bullet in self.bullets[:]:

            # 화면 밖 총알 삭제
            if (
                bullet.x < 0 or
                bullet.x > WIDTH or
                bullet.y < 0 or
                bullet.y > HEIGHT
            ):

                self.bullets.remove(
                    bullet
                )

                continue

            for zombie in self.zombies[:]:

                distance = math.hypot(
                    bullet.x - zombie.x,
                    bullet.y - zombie.y
                )

                if distance < (
                    bullet.radius +
                    zombie.radius
                ):

                    zombie.hp -= 15

                    # 총알 제거
                    if bullet in self.bullets:

                        self.bullets.remove(
                            bullet
                        )

                    # 좀비 죽음
                    if zombie.hp <= 0:

                        if zombie in self.zombies:

                            self.zombies.remove(
                                zombie
                            )

                    break

        # -------------------------
        # 좀비가 플레이어 공격
        # -------------------------

        for zombie in self.zombies:

            distance = math.hypot(
                zombie.x - self.player.x,
                zombie.y - self.player.y
            )

            if distance < (
                zombie.radius +
                self.player.radius
            ):

                self.player.hp -= 1

                if self.player.hp <= 0:

                    self.player.hp = 0

                    self.game_over = True

        # -------------------------
        # 웨이브 클리어
        # -------------------------

        if len(self.zombies) == 0:

            self.wave += 1

            self.spawn_wave()

    # -------------------------
    # 화면 그리기
    # -------------------------

    def draw(self):

        screen.fill(
            (25, 25, 25)
        )

        # 플레이어
        self.player.draw()

        # 총알
        for bullet in self.bullets:

            bullet.draw()

        # 좀비
        for zombie in self.zombies:

            zombie.draw()

        # HP
        hp_text = font.render(
            f"HP: {self.player.hp}/{self.player.max_hp}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            hp_text,
            (20, 20)
        )

        # 웨이브
        wave_text = font.render(
            f"WAVE: {self.wave}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            wave_text,
            (20, 55)
        )

        # 좀비 수
        zombie_text = font.render(
            f"ZOMBIES: {len(self.zombies)}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            zombie_text,
            (20, 90)
        )

        # 게임오버
        if self.game_over:

            text = big_font.render(
                "GAME OVER",
                True,
                (255, 50, 50)
            )

            screen.blit(
                text,
                (330, 250)
            )

            restart = font.render(
                "Press R to Restart",
                True,
                (255, 255, 255)
            )

            screen.blit(
                restart,
                (360, 320)
            )

        pygame.display.flip()


# =========================
# 실행
# =========================

game = Game()

running = True

while running:

    running = game.events()

    game.update()

    game.draw()

    clock.tick(60)

pygame.quit()
