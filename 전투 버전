# 기본 설정
# =========================================================

WIDTH = 1100
HEIGHT = 700
FPS = 60

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("AI Arena - 2 Player Battle")

clock = pygame.time.Clock()

font = pygame.font.SysFont("malgungothic", 26)
small_font = pygame.font.SysFont("malgungothic", 19)
big_font = pygame.font.SysFont("malgungothic", 60)


# =========================================================
# 색상
# =========================================================

WHITE = (245, 245, 245)
BLACK = (18, 18, 22)

GRAY = (80, 80, 90)
DARK_GRAY = (40, 40, 48)

BLUE = (60, 130, 255)
LIGHT_BLUE = (130, 180, 255)

RED = (235, 70, 70)
LIGHT_RED = (255, 130, 130)

GREEN = (70, 210, 100)
YELLOW = (255, 220, 70)

ORANGE = (255, 150, 50)

PURPLE = (170, 100, 255)


# =========================================================
# 맵 설정
# =========================================================

MAP_TOP = 120
MAP_BOTTOM = HEIGHT - 60


# =========================================================
# 장애물
# =========================================================

obstacles = [

    pygame.Rect(350, 210, 150, 40),
    pygame.Rect(600, 210, 150, 40),

    pygame.Rect(350, 450, 150, 40),
    pygame.Rect(600, 450, 150, 40),

    pygame.Rect(510, 290, 80, 120)
]


# =========================================================
# 파티클
# =========================================================

particles = []


class Particle:

    def __init__(self, x, y, color):

        self.x = x
        self.y = y

        self.vx = random.uniform(-4, 4)
        self.vy = random.uniform(-4, 4)

        self.life = random.randint(15, 30)

        self.color = color

        self.size = random.randint(3, 7)


    def update(self):

        self.x += self.vx
        self.y += self.vy

        self.vx *= 0.95
        self.vy *= 0.95

        self.life -= 1


    def draw(self):

        if self.life > 0:

            pygame.draw.circle(
                screen,
                self.color,
                (int(self.x), int(self.y)),
                self.size
            )


def create_particles(x, y, color):

    for _ in range(15):

        particles.append(
            Particle(x, y, color)
        )


# =========================================================
# 플레이어
# =========================================================

class Player:

    def __init__(
        self,
        x,
        y,
        color,
        controls,
        name
    ):

        self.start_x = x
        self.start_y = y

        self.x = x
        self.y = y

        self.color = color

        self.name = name

        self.controls = controls

        # 이동
        self.speed = 4.5

        # 체력
        self.max_hp = 100
        self.hp = 100

        # 공격
        self.attack_range = 75
        self.attack_damage = 12

        self.attack_cooldown = 0
        self.attack_delay = 35

        self.attacking = False
        self.attack_timer = 0

        # 대시
        self.dash_cooldown = 0
        self.dash_delay = 90

        # 방향
        self.direction_x = 1
        self.direction_y = 0

        # AI 학습용 기록
        self.action_history = []


    # =====================================================
    # 이동
    # =====================================================

    def move(self, keys):

        dx = 0
        dy = 0

        if keys[self.controls["up"]]:
            dy -= 1

        if keys[self.controls["down"]]:
            dy += 1

        if keys[self.controls["left"]]:
            dx -= 1

        if keys[self.controls["right"]]:
            dx += 1


        if dx != 0 or dy != 0:

            length = math.sqrt(
                dx * dx + dy * dy
            )

            dx /= length
            dy /= length

            self.direction_x = dx
            self.direction_y = dy

            new_x = self.x + dx * self.speed
            new_y = self.y + dy * self.speed

            if not self.collides(
                new_x,
                new_y
            ):

                self.x = new_x
                self.y = new_y


            # AI 학습 데이터
            self.action_history.append({

                "action": "move",

                "x": round(self.x, 1),

                "y": round(self.y, 1),

                "dx": round(dx, 2),

                "dy": round(dy, 2)

            })


    # =====================================================
    # 장애물 충돌
    # =====================================================

    def collides(self, x, y):

        player_rect = pygame.Rect(
            int(x - 18),
            int(y - 18),
            36,
            36
        )

        for obstacle in obstacles:

            if player_rect.colliderect(obstacle):

                return True

        return False


    # =====================================================
    # 대시
    # =====================================================

    def dash(self):

        if self.dash_cooldown > 0:

            return


        dx = self.direction_x
        dy = self.direction_y

        if dx == 0 and dy == 0:

            dx = 1


        for _ in range(10):

            new_x = self.x + dx * 8
            new_y = self.y + dy * 8

            if not self.collides(
                new_x,
                new_y
            ):

                self.x = new_x
                self.y = new_y

            else:

                break


        self.dash_cooldown = self.dash_delay

        create_particles(
            self.x,
            self.y,
            self.color
        )


        self.action_history.append({

            "action": "dash",

            "x": self.x,

            "y": self.y

        })


    # =====================================================
    # 공격
    # =====================================================

    def attack(self, target):

        if self.attack_cooldown > 0:

            return


        self.attack_cooldown = self.attack_delay

        self.attacking = True

        self.attack_timer = 15


        distance = math.dist(
            (self.x, self.y),
            (target.x, target.y)
        )


        # 공격 범위 안에 있는 경우
        if distance <= self.attack_range:

            target.hp -= self.attack_damage

            if target.hp < 0:

                target.hp = 0


            # 공격 이펙트
            create_particles(
                target.x,
                target.y,
                YELLOW
            )


            self.action_history.append({

                "action": "hit",

                "distance": round(
                    distance,
                    2
                )

            })

        else:

            self.action_history.append({

                "action": "miss",

                "distance": round(
                    distance,
                    2
                )

            })


    # =====================================================
    # 업데이트
    # =====================================================

    def update(self):

        if self.attack_cooldown > 0:

            self.attack_cooldown -= 1


        if self.dash_cooldown > 0:

            self.dash_cooldown -= 1


        if self.attack_timer > 0:

            self.attack_timer -= 1

        else:

            self.attacking = False


        # 화면 제한

        self.x = max(
            30,
            min(WIDTH - 30, self.x)
        )

        self.y = max(
            MAP_TOP + 35,
            min(MAP_BOTTOM - 35, self.y)
        )


    # =====================================================
    # 사람 + 검 그리기
    # =====================================================

    def draw(self):

        x = int(self.x)
        y = int(self.y)


        # 그림자

        pygame.draw.ellipse(
            screen,
            (10, 10, 12),
            (
                x - 22,
                y + 28,
                44,
                12
            )
        )


        # -------------------------
        # 머리
        # -------------------------

        pygame.draw.circle(
            screen,
            self.color,
            (x, y - 30),
            13
        )


        # -------------------------
        # 몸통
        # -------------------------

        pygame.draw.line(
            screen,
            self.color,
            (x, y - 16),
            (x, y + 15),
            9
        )


        # -------------------------
        # 팔
        # -------------------------

        if self.attacking:

            # 공격 중이면 팔을 앞으로 뻗음

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (
                    x + self.direction_x * 28,
                    y - 8 + self.direction_y * 28
                ),
                7
            )

        else:

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (x - 18, y + 10),
                6
            )

            pygame.draw.line(
                screen,
                self.color,
                (x, y - 8),
                (x + 18, y + 10),
                6
            )


        # -------------------------
        # 다리
        # -------------------------

        pygame.draw.line(
            screen,
            self.color,
            (x, y + 15),
            (x - 14, y + 40),
            7
        )

        pygame.draw.line(
            screen,
            self.color,
            (x, y + 15),
            (x + 14, y + 40),
            7
        )


        # -------------------------
        # 검
        # -------------------------

        if self.attacking:

            # 공격 방향

            angle = math.atan2(
                self.direction_y,
                self.direction_x
            )


            sword_length = 65


            start_x = x + math.cos(angle) * 18
            start_y = y + math.sin(angle) * 18


            end_x = x + math.cos(angle) * sword_length
            end_y = y + math.sin(angle) * sword_length


            # 검날

            pygame.draw.line(
                screen,
                WHITE,
                (start_x, start_y),
                (end_x, end_y),
                7
            )


            # 검 손잡이

            pygame.draw.line(
                screen,
                ORANGE,
                (
                    start_x - math.sin(angle) * 10,
                    start_y + math.cos(angle) * 10
                ),
                (
                    start_x + math.sin(angle) * 10,
                    start_y - math.cos(angle) * 10
                ),
                5
            )


            # 공격 궤적

            pygame.draw.arc(
                screen,
                YELLOW,
                (
                    x - 50,
                    y - 50,
                    100,
                    100
                ),
                angle - 0.8,
                angle + 0.8,
                4
            )


        # -------------------------
        # 이름
        # -------------------------

        name_text = small_font.render(
            self.name,
            True,
            WHITE
        )

        screen.blit(
            name_text,
            (
                x - name_text.get_width() // 2,
                y - 65
            )
        )


# =========================================================
# 체력바
# =========================================================

def draw_hp_bar(
    x,
    y,
    hp,
    color,
    name
):

    width = 380
    height = 24


    # 배경

    pygame.draw.rect(
        screen,
        DARK_GRAY,
        (
            x,
            y,
            width,
            height
        )
    )


    # 체력

    hp_width = int(
        width * hp / 100
    )


    pygame.draw.rect(
        screen,
        color,
        (
            x,
            y,
            hp_width,
            height
        )
    )


    # 테두리

    pygame.draw.rect(
        screen,
        WHITE,
        (
            x,
            y,
            width,
            height
        ),
        2
    )


    text = font.render(
        f"{name}  HP: {hp}",
        True,
        WHITE
    )


    screen.blit(
        text,
        (
            x,
            y - 32
        )
    )


# =========================================================
# 플레이어 생성
# =========================================================

player1 = Player(

    180,
    350,

    BLUE,

    {
        "up": pygame.K_w,
        "down": pygame.K_s,
        "left": pygame.K_a,
        "right": pygame.K_d
    },

    "PLAYER 1"

)


player2 = Player(

    920,
    350,

    RED,

    {
        "up": pygame.K_UP,
        "down": pygame.K_DOWN,
        "left": pygame.K_LEFT,
        "right": pygame.K_RIGHT
    },

    "PLAYER 2"

)


# =========================================================
# 게임 상태
# =========================================================

running = True

game_over = False

winner = None

game_history = []


# =========================================================
# 게임 초기화
# =========================================================

def reset_game():

    global game_over
    global winner

    player1.x = player1.start_x
    player1.y = player1.start_y

    player2.x = player2.start_x
    player2.y = player2.start_y

    player1.hp = 100
    player2.hp = 100

    player1.attack_cooldown = 0
    player2.attack_cooldown = 0

    player1.dash_cooldown = 0
    player2.dash_cooldown = 0

    player1.attacking = False
    player2.attacking = False

    player1.action_history.clear()
    player2.action_history.clear()

    game_history.clear()

    particles.clear()

    game_over = False
    winner = None


# =========================================================
# 메인 루프
# =========================================================

while running:

    clock.tick(FPS)


    # =====================================================
    # 이벤트
    # =====================================================

    for event in pygame.event.get():


        if event.type == pygame.QUIT:

            running = False


        if event.type == pygame.KEYDOWN:


            # ---------------------------------------------
            # P1 공격
            # ---------------------------------------------

            if (
                event.key == pygame.K_f
                and not game_over
            ):

                player1.attack(player2)


                game_history.append({

                    "player": 1,

                    "action": "attack",

                    "distance": math.dist(
                        (player1.x, player1.y),
                        (player2.x, player2.y)
                    )

                })


            # ---------------------------------------------
            # P1 대시
            # ---------------------------------------------

            if (
                event.key == pygame.K_g
                and not game_over
            ):

                player1.dash()


            # ---------------------------------------------
            # P2 공격
            # ---------------------------------------------

            if (
                event.key == pygame.K_l
                and not game_over
            ):

                player2.attack(player1)


                game_history.append({

                    "player": 2,

                    "action": "attack",

                    "distance": math.dist(
                        (player2.x, player2.y),
                        (player1.x, player1.y)
                    )

                })


            # ---------------------------------------------
            # P2 대시
            # ---------------------------------------------

            if (
                event.key == pygame.K_k
                and not game_over
            ):

                player2.dash()


            # ---------------------------------------------
            # 재시작
            # ---------------------------------------------

            if event.key == pygame.K_r:

                reset_game()


    # =====================================================
    # 이동
    # =====================================================

    keys = pygame.key.get_pressed()


    if not game_over:

        player1.move(keys)
        player2.move(keys)

        player1.update()
        player2.update()


    # =====================================================
    # 파티클 업데이트
    # =====================================================

    for particle in particles:

        particle.update()


    particles = [

        particle
        for particle in particles
        if particle.life > 0

    ]


    # =====================================================
    # 승패
    # =====================================================

    if player1.hp <= 0:

        player1.hp = 0

        game_over = True

        winner = "PLAYER 2"


    elif player2.hp <= 0:

        player2.hp = 0

        game_over = True

        winner = "PLAYER 1"


    # =====================================================
    # 배경
    # =====================================================

    screen.fill(
        (25, 28, 35)
    )


    # =====================================================
    # 상단 UI
    # =====================================================

    pygame.draw.rect(
        screen,
        (35, 38, 48),
        (
            0,
            0,
            WIDTH,
            110
        )
    )


    # P1 체력

    draw_hp_bar(
        40,
        65,
        player1.hp,
        BLUE,
        "PLAYER 1"
    )


    # P2 체력

    draw_hp_bar(
        WIDTH - 420,
        65,
        player2.hp,
        RED,
        "PLAYER 2"
    )


    # =====================================================
    # 맵 바닥
    # =====================================================

    pygame.draw.rect(
        screen,
        (32, 35, 42),
        (
            0,
            MAP_TOP,
            WIDTH,
            MAP_BOTTOM - MAP_TOP
        )
    )


    # 바닥 격자

    for x in range(
        0,
        WIDTH,
        50
    ):

        pygame.draw.line(
            screen,
            (38, 41, 49),
            (x, MAP_TOP),
            (x, MAP_BOTTOM),
            1
        )


    for y in range(
        MAP_TOP,
        MAP_BOTTOM,
        50
    ):

        pygame.draw.line(
            screen,
            (38, 41, 49),
            (0, y),
            (WIDTH, y),
            1
        )


    # =====================================================
    # 장애물
    # =====================================================

    for obstacle in obstacles:

        pygame.draw.rect(
            screen,
            (90, 95, 110),
            obstacle,
            border_radius=8
        )

        pygame.draw.rect(
            screen,
            (130, 135, 150),
            obstacle,
            2,
            border_radius=8
        )


    # =====================================================
    # 중앙 장식
    # =====================================================

    pygame.draw.circle(
        screen,
        (45, 48, 58),
        (WIDTH // 2, 350),
        100,
        3
    )


    # =====================================================
    # 파티클
    # =====================================================

    for particle in particles:

        particle.draw()


    # =====================================================
    # 플레이어
    # =====================================================

    player1.draw()
    player2.draw()


    # =====================================================
    # 조작법
    # =====================================================

    p1_text = small_font.render(
        "P1  WASD 이동 | F 공격 | G 대시",
        True,
        LIGHT_BLUE
    )


    p2_text = small_font.render(
        "P2  방향키 이동 | L 공격 | K 대시",
        True,
        LIGHT_RED
    )


    screen.blit(
        p1_text,
        (20, HEIGHT - 40)
    )


    screen.blit(
        p2_text,
        (WIDTH - 350, HEIGHT - 40)
    )


    # =====================================================
    # 게임 종료
    # =====================================================

    if game_over:

        overlay = pygame.Surface(
            (WIDTH, HEIGHT),
            pygame.SRCALPHA
        )

        overlay.fill(
            (0, 0, 0, 190)
        )

        screen.blit(
            overlay,
            (0, 0)
        )


        win_text = big_font.render(
            winner + " WIN!",
            True,
            YELLOW
        )


        screen.blit(
            win_text,
            (
                WIDTH // 2 -
                win_text.get_width() // 2,
                HEIGHT // 2 - 60
            )
        )


        restart_text = font.render(
            "R 키를 눌러 다시 시작",
            True,
            WHITE
        )


        screen.blit(
            restart_text,
            (
                WIDTH // 2 -
                restart_text.get_width() // 2,
                HEIGHT // 2 + 30
            )
        )


    # =====================================================
    # 화면 업데이트
    # =====================================================

    pygame.display.flip()


# =========================================================
# 종료
# =========================================================

pygame.quit()


