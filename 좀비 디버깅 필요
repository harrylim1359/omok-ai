            (280, 440)
        )

        coins = font.render(
            f"Coins: {self.coins}",
            True,
            (255, 215, 0)
        )

        screen.blit(
            coins,
            (20, 20)
        )

        close = font.render(
            "Press B to close",
            True,
            WHITE
        )

        screen.blit(
            close,
            (20, HEIGHT - 40)
        )

    # -----------------------------------------------------

    def draw(self):

        screen.fill(
            (25, 25, 25)
        )

        # 장애물
        for obstacle in self.obstacles:

            obstacle.draw()

        # 플레이어
        self.player.draw()

        # 총알
        for bullet in self.bullets:

            bullet.draw()

        # 좀비
        for zombie in self.zombies:

            zombie.draw()

        # 파티클
        self.particles.draw()

        # UI
        self.draw_ui()

        # 조준점
        if not self.shop:

            mouse_x, mouse_y = pygame.mouse.get_pos()

            pygame.draw.circle(
                screen,
                WHITE,
                (mouse_x, mouse_y),
                8,
                1
            )

            pygame.draw.line(
                screen,
                WHITE,
                (
                    mouse_x - 12,
                    mouse_y
                ),
                (
                    mouse_x + 12,
                    mouse_y
                ),
                1
            )

            pygame.draw.line(
                screen,
                WHITE,
                (
                    mouse_x,
                    mouse_y - 12
                ),
                (
                    mouse_x,
                    mouse_y + 12
                ),
                1
            )

        # 상점
        if self.shop:

            self.draw_shop()

        # 게임오버
        if self.game_over:

            overlay = pygame.Surface(
                (WIDTH, HEIGHT)
            )

            overlay.set_alpha(150)

            overlay.fill(BLACK)

            screen.blit(
                overlay,
                (0, 0)
            )

            text = big_font.render(
                "GAME OVER",
                True,
                RED
            )

            screen.blit(
                text,
                (
                    WIDTH // 2 - 150,
                    HEIGHT // 2 - 50
                )
            )

            restart = font.render(
                "Press R to Restart",
                True,
                WHITE
            )

            screen.blit(
                restart,
                (
                    WIDTH // 2 - 100,
                    HEIGHT // 2 + 20
                )
            )

        pygame.display.flip()


# =========================================================
# 실행
# =========================================================

game = Game()

running = True

while running:

    running = game.handle_events()

    game.update()

    game.draw()

    clock.tick(60)

pygame.quit()
