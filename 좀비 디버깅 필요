# =========================================================
# 총알
# =========================================================

class Bullet:

    def __init__(
        self,
        x,
        y,
        dx,
        dy,
        damage
    ):

        self.x = x
        self.y = y

        self.dx = dx
        self.dy = dy

        self.speed = 12

        self.radius = 5

        self.damage = damage

    def update(self):

        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def draw(self):

        pygame.draw.circle(
            screen,
            YELLOW,
            (int(self.x), int(self.y)),
            self.radius
        )

    def is_outside(self):

        return (
            self.x < 0 or
            self.x > WIDTH or
            self.y < 0 or
            self.y > HEIGHT
        )


# =========================================================
# 플레이어
# =========================================================

class Player:

    def __init__(self, obstacles):

        self.x = WIDTH // 2
        self.y = HEIGHT // 2

        self.radius = 20

        self.speed = 5

        self.max_hp = 100
        self.hp = 100

        # 공격력
        self.damage = 15

        # 공격 쿨다운
        self.shoot_cooldown = 0

        self.shoot_delay = 10

        self.obstacles = obstacles

    # -----------------------------------------------------

    def move(self):

        keys = pygame.key.get_pressed()

        dx = 0
        dy = 0

        if keys[pygame.K_w]:
            dy -= self.speed

        if keys[pygame.K_s]:
            dy += self.speed

        if keys[pygame.K_a]:
            dx -= self.speed

        if keys[pygame.K_d]:
            dx += self.speed

        # 대각선 속도 보정
        if dx != 0 and dy != 0:

            dx *= 0.707
            dy *= 0.707

        # X 이동
        new_x = self.x + dx

        if can_move(
            new_x,
            self.y,
            self.radius,
            self.obstacles
        ):
            self.x = new_x

        # Y 이동
        new_y = self.y + dy

        if can_move(
            self.x,
            new_y,
            self.radius,
            self.obstacles
        ):
            self.y = new_y

    # -----------------------------------------------------

    def update(self):

        self.move()

        if self.shoot_cooldown > 0:
            self.shoot_cooldown -= 1

    # -----------------------------------------------------

    def shoot(self, mouse_x, mouse_y):

        if self.shoot_cooldown > 0:
            return None

        dx = mouse_x - self.x
        dy = mouse_y - self.y

        distance = math.hypot(dx, dy)

        if distance == 0:
            return None

        dx /= distance
        dy /= distance

        self.shoot_cooldown = self.shoot_delay

        return Bullet(
            self.x,
            self.y,
            dx,
            dy,
            self.damage
        )

    # -----------------------------------------------------

    def draw(self):

        pygame.draw.circle(
            screen,
            BLUE,
            (int(self.x), int(self.y)),
            self.radius
        )

        # 체력바

        bar_width = 50

        pygame.draw.rect(
            screen,
            RED,
            (
                self.x - bar_width // 2,
                self.y - 35,
                bar_width,
                6
            )
        )

        pygame.draw.rect(
            screen,
            GREEN,
            (
                self.x - bar_width // 2,
                self.y - 35,
                bar_width * max(
                    self.hp / self.max_hp,
                    0
                ),
                6
            )
        )


# =========================================================
# 좀비
# =========================================================

class Zombie:

    def __init__(
        self,
        x,
        y,
        speed,
        hp=30,
        damage=1,
        radius=18,
        color=GREEN
    ):

        self.x = x
        self.y = y

        self.radius = radius

        self.speed = speed

        self.max_hp = hp
        self.hp = hp

        self.damage = damage

        self.color = color

    # -----------------------------------------------------

    def try_move(self, dx, dy, obstacles):

        # X와 Y를 따로 움직여서
        # 장애물 모서리를 돌아갈 수 있게 함

        new_x = self.x + dx

        if can_move(
            new_x,
            self.y,
            self.radius,
            obstacles
        ):
            self.x = new_x

        new_y = self.y + dy

        if can_move(
            self.x,
            new_y,
            self.radius,
            obstacles
        ):
            self.y = new_y

    # -----------------------------------------------------

    def update(
        self,
        player,
        obstacles
    ):

        dx = player.x - self.x
        dy = player.y - self.y

        distance = math.hypot(dx, dy)

        if distance == 0:
            return

        dx /= distance
        dy /= distance

        move_x = dx * self.speed
        move_y = dy * self.speed

        old_x = self.x
        old_y = self.y

        # 먼저 플레이어 방향으로 이동
        self.try_move(
            move_x,
            move_y,
            obstacles
        )

        # 거의 움직이지 못했다면
        # 옆 방향으로 돌아가기
        if (
            abs(self.x - old_x) < 0.01 and
            abs(self.y - old_y) < 0.01
        ):

            # 가로 방향
            self.try_move(
                -dy * self.speed,
                dx * self.speed,
                obstacles
            )

            # 그래도 안 되면 반대쪽
            if (
                abs(self.x - old_x) < 0.01 and
                abs(self.y - old_y) < 0.01
            ):

                self.try_move(
                    dy * self.speed,
                    -dx * self.speed,
                    obstacles
                )

    # -----------------------------------------------------

    def draw(self):

        pygame.draw.circle(
            screen,
            self.color,
            (int(self.x), int(self.y)),
            self.radius
        )

        # 눈
        pygame.draw.circle(
            screen,
            WHITE,
            (
                int(self.x - 6),
                int(self.y - 4)
            ),
            3
        )

        pygame.draw.circle(
            screen,
            WHITE,
            (
                int(self.x + 6),
                int(self.y - 4)
            ),
            3
        )

        # 체력바

        width = self.radius * 2

        pygame.draw.rect(
            screen,
            RED,
            (
                self.x - self.radius,
                self.y - self.radius - 10,
                width,
                4
            )
        )

        pygame.draw.rect(
            screen,
            GREEN,
            (
                self.x - self.radius,
                self.y - self.radius - 10,
                width * max(
                    self.hp / self.max_hp,
                    0
                ),
                4
            )
        )


