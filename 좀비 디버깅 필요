# =========================================================
# 게임
# =========================================================

class Game:

    def __init__(self):

        self.create_obstacles()

        self.player = Player(
            self.obstacles
        )

        self.bullets = []
        self.zombies = []

        self.particles = ParticleManager()

        self.wave = 1
        self.score = 0
        self.coins = 0

        self.game_over = False

        self.shop = False

        self.spawn_zombies()

    # -----------------------------------------------------

    def create_obstacles(self):

        self.obstacles = [

            Obstacle(
                170,
                120,
                170,
                35
            ),

            Obstacle(
                560,
                120,
                170,
                35
            ),

            Obstacle(
                170,
                445,
                170,
                35
            ),

            Obstacle(
                560,
                445,
                170,
                35
            ),

            Obstacle(
                410,
                220,
                80,
                160
            )
        ]

    # -----------------------------------------------------

    def random_spawn_position(self):

        for _ in range(100):

            side = random.randint(0, 3)

            if side == 0:

                x = random.randint(
                    30,
                    WIDTH - 30
                )

                y = 25

            elif side == 1:

                x = random.randint(
                    30,
                    WIDTH - 30
                )

                y = HEIGHT - 25

            elif side == 2:

                x = 25

                y = random.randint(
                    30,
                    HEIGHT - 30
                )

            else:

                x = WIDTH - 25

                y = random.randint(
                    30,
                    HEIGHT - 30
                )

            # 플레이어와 너무 가까우면 다시
            if math.hypot(
                x - self.player.x,
                y - self.player.y
            ) < 200:

                continue

            if can_move(
                x,
                y,
                20,
                self.obstacles
            ):

                return x, y

        return 50, 50

    # -----------------------------------------------------

    def spawn_zombies(self):

        self.zombies.clear()

        amount = 3 + self.wave * 2

        for _ in range(amount):

            x, y = self.random_spawn_position()

            speed = 1.0 + self.wave * 0.08

            hp = 30 + self.wave * 5

            zombie = Zombie(
                x,
                y,
                speed,
                hp
            )

            self.zombies.append(zombie)

        # 5의 배수 웨이브마다 보스
        if self.wave % 5 == 0:

            x, y = self.random_spawn_position()

            self.zombies.append(
                BossZombie(
                    x,
                    y,
                    self.wave
                )
            )

    # -----------------------------------------------------

    def handle_events(self):

        for event in pygame.event.get():

            if event.type == pygame.QUIT:

                return False

            # 한 번 클릭 = 한 발
            if event.type == pygame.MOUSEBUTTONDOWN:

                if event.button == 1:

                    # 게임 중
                    if not self.game_over and not self.shop:

                        mouse_x, mouse_y = pygame.mouse.get_pos()

                        bullet = self.player.shoot(
                            mouse_x,
                            mouse_y
                        )

                        if bullet:

                            self.bullets.append(
                                bullet
                            )

                    # 상점 클릭
                    elif self.shop:

                        self.shop_click(
                            event.pos
                        )

            if event.type == pygame.KEYDOWN:

                # 게임 오버
                if event.key == pygame.K_r:

                    if self.game_over:

                        self.__init__()

                # 상점 열기
                if event.key == pygame.K_b:

                    if not self.game_over:

                        self.shop = not self.shop

        return True

    # -----------------------------------------------------

    def shop_click(self, pos):

        x, y = pos

        # 공격력 업그레이드
        attack_rect = pygame.Rect(
            250,
            180,
            400,
            60
        )

        # 공격속도 업그레이드
        speed_rect = pygame.Rect(
            250,
            260,
            400,
            60
        )

        # 이동속도 업그레이드
        move_rect = pygame.Rect(
            250,
            340,
            400,
            60
        )

        # 체력 회복
        heal_rect = pygame.Rect(
            250,
            420,
            400,
            60
        )

        # 공격력
        if attack_rect.collidepoint(pos):

            if self.coins >= 20:

                self.coins -= 20

                self.player.damage += 5

        # 공격속도
        elif speed_rect.collidepoint(pos):

            if self.coins >= 30:

                self.coins -= 30

                self.player.shoot_delay = max(
                    2,
                    self.player.shoot_delay - 2
                )

        # 이동속도
        elif move_rect.collidepoint(pos):

            if self.coins >= 25:

                self.coins -= 25

                self.player.speed += 0.5

        # 회복
        elif heal_rect.collidepoint(pos):

            if self.coins >= 15:

                self.coins -= 15

                self.player.hp = min(
                    self.player.max_hp,
                    self.player.hp + 30
                )

    # -----------------------------------------------------

    def update(self):

        if self.game_over:
            return

        # 상점 열려 있으면 게임 멈춤
        if self.shop:

            self.particles.update()

            return

        # 플레이어
        self.player.update()

        # 총알
        for bullet in self.bullets:

            bullet.update()

        # 총알 삭제
        self.bullets = [
            bullet
            for bullet in self.bullets
            if not bullet.is_outside()
        ]

        # 좀비
        for zombie in self.zombies:

            zombie.update(
                self.player,
                self.obstacles
            )

        # 총알과 좀비 충돌
        for bullet in self.bullets[:]:

            # 장애물에 총알이 닿으면 제거
            hit_wall = False

            for obstacle in self.obstacles:

                if obstacle.rect.collidepoint(
                    int(bullet.x),
                    int(bullet.y)
                ):

                    hit_wall = True
                    break

            if hit_wall:

                if bullet in self.bullets:
                    self.bullets.remove(bullet)

                continue

            # 좀비와 충돌
            for zombie in self.zombies[:]:

                distance = math.hypot(
                    bullet.x - zombie.x,
                    bullet.y - zombie.y
                )

                if distance < (
                    bullet.radius +
                    zombie.radius
                ):

                    zombie.hp -= bullet.damage

                    if bullet in self.bullets:

                        self.bullets.remove(
                            bullet
                        )

                    self.particles.create(
                        zombie.x,
                        zombie.y,
                        ORANGE,
                        5
                    )

                    # 좀비 죽음
                    if zombie.hp <= 0:

                        self.score += 10

                        # 보스는 더 많은 코인
                        if isinstance(
                            zombie,
                            BossZombie
                        ):

                            self.coins += 30

                            self.particles.create(
                                zombie.x,
                                zombie.y,
                                (255, 0, 255),
                                25
                            )

                        else:

                            self.coins += 5

                            self.particles.create(
                                zombie.x,
                                zombie.y,
                                GREEN,
                                12
                            )

                        self.zombies.remove(
                            zombie
                        )

                    break

        # 좀비와 플레이어 충돌
        for zombie in self.zombies:

            distance = math.hypot(
                zombie.x - self.player.x,
                zombie.y - self.player.y
            )

            if distance < (
                zombie.radius +
                self.player.radius
            ):

                self.player.hp -= zombie.damage

                # 좀비 밀어내기
                dx = self.player.x - zombie.x
                dy = self.player.y - zombie.y

                dist = math.hypot(dx, dy)

                if dist != 0:

                    self.player.x += (
                        dx / dist * 8
                    )

                    self.player.y += (
                        dy / dist * 8
                    )

                self.particles.create(
                    self.player.x,
                    self.player.y,
                    RED,
                    5
                )

                if self.player.hp <= 0:

                    self.player.hp = 0

                    self.game_over = True

        # 파티클
        self.particles.update()

        # 웨이브 클리어
        if len(self.zombies) == 0:

            self.wave += 1

            # 웨이브 클리어 보너스
            self.coins += 10

            # 다음 웨이브
            self.spawn_zombies()

