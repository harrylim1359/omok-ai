# =========================================================
# 유틸
# =========================================================

def circle_rect_collision(x, y, radius, rect):
    closest_x = max(rect.left, min(x, rect.right))
    closest_y = max(rect.top, min(y, rect.bottom))

    distance = math.hypot(
        x - closest_x,
        y - closest_y
    )

    return distance < radius


def can_move(x, y, radius, obstacles):
    # 화면 밖
    if x - radius < 0:
        return False

    if x + radius > WIDTH:
        return False

    if y - radius < 0:
        return False

    if y + radius > HEIGHT:
        return False

    # 장애물
    for obstacle in obstacles:
        if circle_rect_collision(
            x,
            y,
            radius,
            obstacle.rect
        ):
            return False

    return True


