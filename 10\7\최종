import pygame
import math
import random

pygame.init()

WIDTH = 900
HEIGHT = 600

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Zombie Wave")

clock = pygame.time.Clock()

font = pygame.font.SysFont(None, 30)
big_font = pygame.font.SysFont(None, 60)


# ==================================================
# Gun
# ==================================================

class Gun:

    def __init__(self, image_path):

        self.image = pygame.image.load(
            image_path
        ).convert_alpha()

        self.image = pygame.transform.scale(
            self.image,
            (30, 15)
        )

        self.image = pygame.transform.flip(
            self.image,
            False,
            True
        )

        self.x = 0
        self.y = 0
        self.angle = 0

    def update(self, x, y, mx, my):

        dx = mx - x
        dy = my - y

        distance = math.hypot(dx, dy)

        if distance != 0:
            dx /= distance
            dy /= distance

        # 플레이어에서 바라보는 방향으로 10만큼 떨어짐
        self.x = x + dx * 10
        self.y = y + dy * 10

        self.angle = math.degrees(
            math.atan2(-dy, dx)
        ) + 180

    def draw(self):

        image = pygame.transform.rotate(
            self.image,
            self.angle
        )

        rect = image.get_rect(
            center=(self.x, self.y)
        )

        screen.blit(image, rect)


# ==================================================
# Monster
# ==================================================

class Monster:

    def __init__(
        self,
        x,
        y,
        radius=18,
        speed=1.5,
        hp=30,
        damage=1
    ):

        self.x = x
        self.y = y

        self.radius = radius
        self.speed = speed

        self.hp = hp
        self.max_hp = hp

        self.damage = damage

        self.dead = False

        self.color = (60, 200, 70)
        self.coin_reward = 5

    # ==================================================
    # Update
    # ==================================================

    def update(self, player):
        pass

    # ==================================================
    # Move
    # ==================================================

    def move(self, player):

        dx = player.x - self.x
        dy = player.y - self.y

        distance = math.hypot(dx, dy)

        if distance > 0:

            self.x += dx / distance * self.speed
            self.y += dy / distance * self.speed

    # ==================================================
    # Attack
    # ==================================================

    def attack_player(self, player):

        distance = math.hypot(
            player.x - self.x,
            player.y - self.y
        )

        if distance < self.radius + player.radius:

            player.hp -= self.damage

            if player.hp <= 0:
                player.hp = 0

    # ==================================================
    # Shoot
    # ==================================================

    def shoot(self, player):
        pass

    # ==================================================
    # Take Damage
    # ==================================================

    def take_damage(self, damage):

        self.hp -= damage

        if self.hp <= 0:

            self.hp = 0
            self.die()

    # ==================================================
    # Die
    # ==================================================

    def die(self):

        self.dead = True

    # ==================================================
    # Special Attack
    # ==================================================

    def special_attack(self, player):
        pass

    # ==================================================
    # Draw
    # ==================================================

    def draw(self):

        pygame.draw.circle(
            screen,
            self.color,
            (
                int(self.x),
                int(self.y)
            ),
            self.radius
        )

    # ==================================================
    # Health Bar
    # ==================================================

    def draw_health_bar(self):

        if self.type == "boss":

            bar_width = 70
            bar_height = 8

        elif self.type == "tank":

            bar_width = 55
            bar_height = 7

        else:

            bar_width = 40
            bar_height = 6

        hp_ratio = self.hp / self.max_hp

        pygame.draw.rect(
            screen,
            (180, 40, 40),
            (
                int(self.x - bar_width / 2),
                int(self.y - self.radius - 12),
                bar_width,
                bar_height
            )
        )

        pygame.draw.rect(
            screen,
            (50, 220, 70),
            (
                int(self.x - bar_width / 2),
                int(self.y - self.radius - 12),
                int(bar_width * hp_ratio),
                bar_height
            )
        )


# ==================================================
# Zombie
# ==================================================

class Zombie(Monster):

    def __init__(self, wave, zombie_type):

        side = random.randint(0, 3)

        if side == 0:

            x = random.randint(0, WIDTH)
            y = 0

        elif side == 1:

            x = random.randint(0, WIDTH)
            y = HEIGHT

        elif side == 2:

            x = 0
            y = random.randint(0, HEIGHT)

        else:

            x = WIDTH
            y = random.randint(0, HEIGHT)

        self.type = zombie_type

        # ==================================================
        # Normal
        # ==================================================

        if zombie_type == "normal":

            radius = 18

            speed = (
                1.5 +
                (wave - 1) * 0.15
            )

            hp = (
                30 +
                (wave - 1) * 10
            )

            damage = (
                1 +
                (wave - 1) // 3
            )

            color = (60, 200, 70)

            coin_reward = 5

        # ==================================================
        # Speed
        # ==================================================

        elif zombie_type == "speed":

            radius = 14

            speed = (
                3.0 +
                (wave - 1) * 0.20
            )

            hp = (
                15 +
                (wave - 1) * 5
            )

            damage = (
                1 +
                (wave - 1) // 4
            )

            color = (255, 220, 50)

            coin_reward = 8

        # ==================================================
        # Tank
        # ==================================================

        elif zombie_type == "tank":

            radius = 25

            speed = (
                0.8 +
                (wave - 1) * 0.08
            )

            hp = (
                80 +
                (wave - 1) * 20
            )

            damage = (
                2 +
                (wave - 1) // 3
            )

            color = (220, 60, 60)

            coin_reward = 12

        # ==================================================
        # Boss
        # ==================================================

        elif zombie_type == "boss":

            radius = 35

            speed = (
                1.0 +
                (wave - 1) * 0.10
            )

            hp = (
                250 +
                (wave - 1) * 50
            )

            damage = (
                5 +
                (wave - 1) // 2
            )

            color = (170, 50, 220)

            coin_reward = 50

        super().__init__(
            x=x,
            y=y,
            radius=radius,
            speed=speed,
            hp=hp,
            damage=damage
        )

        self.color = color
        self.coin_reward = coin_reward

    def update(self, player):

        self.move(player)
        self.attack_player(player)


# ==================================================
# Player
# ==================================================

class Player:

    def __init__(self):

        self.x = 450
        self.y = 300

        self.radius = 20

        self.speed = 5

        self.max_hp = 100
        self.hp = 100

        self.damage = 15

        self.fire_cooldown = 10
        self.cooldown = 0

        self.gun = Gun("gun.png")

    def update(self):

        keys = pygame.key.get_pressed()

        if keys[pygame.K_w]:
            self.y -= self.speed

        if keys[pygame.K_s]:
            self.y += self.speed

        if keys[pygame.K_a]:
            self.x -= self.speed

        if keys[pygame.K_d]:
            self.x += self.speed

        self.x = max(
            self.radius,
            min(WIDTH - self.radius, self.x)
        )

        self.y = max(
            self.radius,
            min(HEIGHT - self.radius, self.y)
        )

        if self.cooldown > 0:
            self.cooldown -= 1

        # 총 방향 업데이트
        mx, my = pygame.mouse.get_pos()

        self.gun.update(
            self.x,
            self.y,
            mx,
            my
        )

    def shoot(self, mx, my):

        if self.cooldown > 0:
            return None

        dx = mx - self.x
        dy = my - self.y

        distance = math.hypot(dx, dy)

        if distance == 0:
            return None

        dx /= distance
        dy /= distance

        self.cooldown = self.fire_cooldown

        return Bullet(
            self.x,
            self.y,
            dx,
            dy,
            self.damage
        )

    def draw(self):

        pygame.draw.circle(
            screen,
            (50, 150, 255),
            (
                int(self.x),
                int(self.y)
            ),
            self.radius
        )

        self.gun.draw()

    def draw_health_bar(self):

        bar_width = 50
        bar_height = 7

        hp_ratio = self.hp / self.max_hp

        pygame.draw.rect(
            screen,
            (180, 40, 40),
            (
                int(self.x - bar_width / 2),
                int(self.y - 35),
                bar_width,
                bar_height
            )
        )

        pygame.draw.rect(
            screen,
            (50, 220, 70),
            (
                int(self.x - bar_width / 2),
                int(self.y - 35),
                int(bar_width * hp_ratio),
                bar_height
            )
        )


# ==================================================
# Bullet
# ==================================================

class Bullet:

    def __init__(
        self,
        x,
        y,
        dx,
        dy,
        damage
    ):

        self.x = x
        self.y = y

        self.dx = dx
        self.dy = dy

        self.speed = 12
        self.radius = 5

        self.damage = damage

    def update(self):

        self.x += self.dx * self.speed
        self.y += self.dy * self.speed

    def draw(self):

        pygame.draw.circle(
            screen,
            (255, 230, 50),
            (
                int(self.x),
                int(self.y)
            ),
            self.radius
        )


# ==================================================
# Game
# ==================================================

class Game:

    def __init__(self):

        self.player = Player()

        self.bullets = []
        self.zombies = []

        self.wave = 1

        self.coins = 0

        self.shop_open = False
        self.game_over = False

        self.spawn_wave()

    # ==================================================
    # Spawn Wave
    # ==================================================

    def spawn_wave(self):

        self.zombies.clear()

        zombie_count = 4 + self.wave

        for i in range(zombie_count):

            # 5웨이브마다 첫 번째가 보스
            if self.wave % 5 == 0 and i == 0:

                zombie_type = "boss"

            else:

                random_number = random.randint(
                    1,
                    100
                )

                if self.wave < 3:

                    if random_number <= 75:
                        zombie_type = "normal"

                    else:
                        zombie_type = "speed"

                elif self.wave < 5:

                    if random_number <= 55:
                        zombie_type = "normal"

                    elif random_number <= 80:
                        zombie_type = "speed"

                    else:
                        zombie_type = "tank"

                else:

                    if random_number <= 40:
                        zombie_type = "normal"

                    elif random_number <= 65:
                        zombie_type = "speed"

                    else:
                        zombie_type = "tank"

            self.zombies.append(
                Zombie(
                    self.wave,
                    zombie_type
                )
            )

    # ==================================================
    # Events
    # ==================================================

    def events(self):

        for event in pygame.event.get():

            if event.type == pygame.QUIT:

                return False

            # ==================================================
            # 공격
            # ==================================================

            if event.type == pygame.MOUSEBUTTONDOWN:

                if event.button == 1:

                    if not self.game_over:

                        if not self.shop_open:

                            mx, my = pygame.mouse.get_pos()

                            bullet = self.player.shoot(
                                mx,
                                my
                            )

                            if bullet:

                                self.bullets.append(
                                    bullet
                                )

            # ==================================================
            # 키
            # ==================================================

            if event.type == pygame.KEYDOWN:

                # 상점
                if event.key == pygame.K_b:

                    if not self.game_over:

                        self.shop_open = not self.shop_open

                # 상점
                if self.shop_open:

                    # 공격력
                    if event.key == pygame.K_1:

                        if self.coins >= 20:

                            self.coins -= 20
                            self.player.damage += 5

                    # 이동속도
                    elif event.key == pygame.K_2:

                        if self.coins >= 25:

                            self.coins -= 25
                            self.player.speed += 1

                    # 회복
                    elif event.key == pygame.K_3:

                        if self.coins >= 15:

                            if self.player.hp < self.player.max_hp:

                                self.coins -= 15

                                self.player.hp += 30

                                if self.player.hp > self.player.max_hp:

                                    self.player.hp = self.player.max_hp

                    # 공격속도
                    elif event.key == pygame.K_4:

                        if self.coins >= 30:

                            if self.player.fire_cooldown > 2:

                                self.coins -= 30

                                self.player.fire_cooldown -= 2

                # 재시작
                if event.key == pygame.K_r:

                    if self.game_over:

                        self.__init__()

        return True

    # ==================================================
    # Update
    # ==================================================

    def update(self):

        if self.game_over:
            return

        # 상점에서는 게임 정지
        if self.shop_open:
            return

        self.player.update()

        # ==================================================
        # 총알
        # ==================================================

        for bullet in self.bullets[:]:

            bullet.update()

            # 화면 밖
            if (
                bullet.x < 0 or
                bullet.x > WIDTH or
                bullet.y < 0 or
                bullet.y > HEIGHT
            ):

                self.bullets.remove(
                    bullet
                )

        # ==================================================
        # 좀비
        # ==================================================

        for zombie in self.zombies:

            zombie.update(
                self.player
            )

        # ==================================================
        # 총알과 좀비 충돌
        # ==================================================

        for bullet in self.bullets[:]:

            for zombie in self.zombies[:]:

                distance = math.hypot(
                    bullet.x - zombie.x,
                    bullet.y - zombie.y
                )

                if distance < (
                    bullet.radius +
                    zombie.radius
                ):

                    zombie.take_damage(
                        bullet.damage
                    )

                    if bullet in self.bullets:

                        self.bullets.remove(
                            bullet
                        )

                    # 사망
                    if zombie.dead:

                        if zombie in self.zombies:

                            self.zombies.remove(
                                zombie
                            )

                            self.coins += (
                                zombie.coin_reward
                            )

                    break

        # ==================================================
        # 좀비와 플레이어
        # ==================================================

        for zombie in self.zombies:

            distance = math.hypot(
                zombie.x - self.player.x,
                zombie.y - self.player.y
            )

            if distance < (
                zombie.radius +
                self.player.radius
            ):

                self.player.hp -= zombie.damage

                if self.player.hp <= 0:

                    self.player.hp = 0

                    self.game_over = True

        # ==================================================
        # 웨이브 클리어
        # ==================================================

        if len(self.zombies) == 0:

            self.wave += 1

            self.coins += 10

            self.spawn_wave()

    # ==================================================
    # Draw
    # ==================================================

    def draw(self):

        screen.fill(
            (25, 25, 25)
        )

        # 플레이어
        self.player.draw()
        self.player.draw_health_bar()

        # 총알
        for bullet in self.bullets:

            bullet.draw()

        # 좀비
        for zombie in self.zombies:

            zombie.draw()
            zombie.draw_health_bar()

        # ==================================================
        # UI
        # ==================================================

        hp_text = font.render(
            f"HP: {self.player.hp}/{self.player.max_hp}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            hp_text,
            (20, 20)
        )

        wave_text = font.render(
            f"WAVE: {self.wave}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            wave_text,
            (20, 55)
        )

        zombie_text = font.render(
            f"ZOMBIES: {len(self.zombies)}",
            True,
            (255, 255, 255)
        )

        screen.blit(
            zombie_text,
            (20, 90)
        )

        coin_text = font.render(
            f"COINS: {self.coins}",
            True,
            (255, 220, 50)
        )

        screen.blit(
            coin_text,
            (20, 125)
        )

        # ==================================================
        # 좀비 종류
        # ==================================================

        legend = [
            ("NORMAL", (60, 200, 70)),
            ("SPEED", (255, 220, 50)),
            ("TANK", (220, 60, 60)),
            ("BOSS", (170, 50, 220))
        ]

        y = 20

        for name, color in legend:

            pygame.draw.circle(
                screen,
                color,
                (760, y + 8),
                7
            )

            text = font.render(
                name,
                True,
                (255, 255, 255)
            )

            screen.blit(
                text,
                (775, y)
            )

            y += 30

        # ==================================================
        # SHOP
        # ==================================================

        if self.shop_open:

            overlay = pygame.Surface(
                (WIDTH, HEIGHT)
            )

            overlay.set_alpha(220)
            overlay.fill(
                (20, 20, 20)
            )

            screen.blit(
                overlay,
                (0, 0)
            )

            title = big_font.render(
                "SHOP",
                True,
                (255, 255, 255)
            )

            screen.blit(
                title,
                (380, 100)
            )

            shop1 = font.render(
                "1 - Damage +5     20 Coins",
                True,
                (255, 255, 255)
            )

            screen.blit(
                shop1,
                (280, 200)
            )

            shop2 = font.render(
                "2 - Speed +1       25 Coins",
                True,
                (255, 255, 255)
            )

            screen.blit(
                shop2,
                (280, 250)
            )

            shop3 = font.render(
                "3 - Heal +30        15 Coins",
                True,
                (255, 255, 255)
            )

            screen.blit(
                shop3,
                (280, 300)
            )

            shop4 = font.render(
                "4 - Fire Rate Up    30 Coins",
                True,
                (255, 255, 255)
            )

            screen.blit(
                shop4,
                (280, 350)
            )

            coins = font.render(
                f"Your Coins: {self.coins}",
                True,
                (255, 220, 50)
            )

            screen.blit(
                coins,
                (350, 420)
            )

            close = font.render(
                "Press B to close",
                True,
                (200, 200, 200)
            )

            screen.blit(
                close,
                (365, 470)
            )

        # ==================================================
        # GAME OVER
        # ==================================================

        if self.game_over:

            text = big_font.render(
                "GAME OVER",
                True,
                (255, 50, 50)
            )

            screen.blit(
                text,
                (330, 250)
            )

            restart = font.render(
                "Press R to Restart",
                True,
                (255, 255, 255)
            )

            screen.blit(
                restart,
                (360, 320)
            )

        pygame.display.flip()


# ==================================================
# 실행
# ==================================================

game = Game()

running = True

while running:

    running = game.events()

    game.update()

    game.draw()

    clock.tick(60)

pygame.quit()
